<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet author="guiom.mary" id="26.5.0-JPA-alignment">

        <modifyDataType tableName="AUTHENTICATION_EXECUTION"
                        columnName="AUTH_CONFIG"
                        newDataType="VARCHAR(255)"/>
        <modifyDataType tableName="AUTHENTICATION_EXECUTION"
                        columnName="AUTHENTICATOR"
                        newDataType="VARCHAR(255)"/>

        <modifyDataType tableName="AUTHENTICATION_EXECUTION"
                        columnName="REQUIREMENT"
                        newDataType="SMALLINT"/>

        <modifyDataType tableName="CLIENT_AUTH_FLOW_BINDINGS"
                        columnName="FLOW_ID"
                        newDataType="VARCHAR(4000)"/>

        <!-- To align with hack in RoleEntity -->
        <modifyDataType tableName="KEYCLOAK_ROLE"
                        columnName="CLIENT_REALM_CONSTRAINT"
                        newDataType="VARCHAR(36)"/>

        <modifyDataType tableName="OFFLINE_CLIENT_SESSION"
                        columnName="CLIENT_ID"
                        newDataType="VARCHAR(36)"/>

        <modifyDataType tableName="ORG"
                        columnName="ID"
                        newDataType="VARCHAR(36)"/>

        <modifyDataType tableName="ORG_DOMAIN"
                        columnName="ORG_ID"
                        newDataType="VARCHAR(36)"/>
        <!-- In OrganizationDomainEntity "verified" field is a boxed Boolean -->
        <dropNotNullConstraint tableName="ORG_DOMAIN" columnName="VERIFIED"/>

        <modifyDataType tableName="REALM_LOCALIZATIONS"
                        columnName="REALM_ID"
                        newDataType="VARCHAR(36)"/>

        <modifyDataType tableName="REVOKED_TOKEN"
                        columnName="ID"
                        newDataType="VARCHAR(36)"/>

        <!-- Superfluous columns added in Liquibase scripts that don't appear in Java code in the whole project (except if I'm wrong) -->
        <dropColumn tableName="AUTHENTICATION_EXECUTION" columnName="ALIAS"/>
        <dropColumn tableName="KEYCLOAK_ROLE" columnName="REALM"/>
        <dropColumn tableName="REALM" columnName="SOCIAL"/>
        <dropColumn tableName="REALM" columnName="UPDATE_PROFILE_ON_SOC_LOGIN"/>
    </changeSet>

</databaseChangeLog>
